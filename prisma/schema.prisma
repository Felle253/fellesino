generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String?  @unique
  createdAt DateTime @default(now())

  passwordHash    String?
  passwordSalt    String?
  passwordAlgo    String?
  passwordVersion Int?    @default(1)

  coins Int @default(1000)

  lastActive DateTime?

  sessions   Session[]
  gameRounds GameRound[]
}

model Session {
  id         String   @id @default(uuid())
  token      String   @unique
  createdAt  DateTime @default(now())
  lastUsed   DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
  ipAddress  String?
  deviceName String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

enum TransactionType {
  BONUS
  BET
  WIN
  REFUND
}

model GameRound {
  id        String      @id @default(uuid())
  status    RoundStatus @default(IN_PROGRESS)
  betAmount Int
  payout    Int?
  createdAt DateTime    @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  blackjackHand BlackjackHand?
}

enum RoundStatus {
  IN_PROGRESS
  WON
  LOST
  PUSH
}

model BlackjackHand {
  id          String  @id @default(uuid())
  playerCards String // KH, 5D, AS, etc.
  dealerCards String
  playerScore Int
  dealerScore Int
  deck        String
  lastAction  String?

  round   GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId String    @unique
}
